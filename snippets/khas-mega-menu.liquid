<div class="khas-mega-menu">

  <!-- LEFT SIDEBAR -->
  <div class="khas-sidebar">
    <button class="khas-sidebar-link active" data-panel="collection">Shop by Collection</button>
    <button class="khas-sidebar-link" data-panel="goal">Shop by Goal</button>
    <button class="khas-sidebar-link" data-panel="lifestyle">Shop by Lifestyle</button>
    <button class="khas-sidebar-link" data-panel="help">Help Me Choose</button>
    <a href="{{ routes.collections_url }}" class="khas-sidebar-btn">Shop All</a>
  </div>

  <!-- RIGHT PANELS -->
  <div class="khas-panels">

    <!-- Panel: Shop by Collection (pulled from Shop nav sub-links) -->
    <div class="khas-grid khas-panel active" data-panel="collection">
      {%- for childlink in link.links -%}
        {%- assign collection = collections[childlink.handle] -%}
        {%- if collection -%}
          <a href="{{ collection.url }}" class="khas-card">
            <h3>{{ collection.title | escape }}</h3>
            <div class="khas-card-arrow">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h12M9 3l5 5-5 5" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 400 | image_tag: class: 'khas-card-img', loading: 'lazy', alt: collection.title }}
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Panel: Shop by Goal (Admin → Navigation → mega-menu-goal) -->
    <div class="khas-grid khas-panel" data-panel="goal">
      {%- assign goal_menu = linklists['shop-by-goal'] -%}
      {%- if goal_menu.links.size > 0 -%}
        {%- for goallink in goal_menu.links -%}
          {%- assign collection = collections[goallink.handle] -%}
          {%- if collection -%}
            <a href="{{ collection.url }}" class="khas-card">
              <h3>{{ collection.title | escape }}</h3>
              <div class="khas-card-arrow">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 8h12M9 3l5 5-5 5" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 400 | image_tag: class: 'khas-card-img', loading: 'lazy', alt: collection.title }}
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <p class="khas-panel-empty">No collections added yet. Go to Admin → Navigation → mega-menu-goal to add collections.</p>
      {%- endif -%}
    </div>

    <!-- Panel: Shop by Lifestyle (Admin → Navigation → mega-menu-lifestyle) -->
    <div class="khas-grid khas-panel" data-panel="lifestyle">
      {%- assign lifestyle_menu = linklists['mega-menu-lifestyle'] -%}
      {%- if lifestyle_menu.links.size > 0 -%}
        {%- for lifestylelink in lifestyle_menu.links -%}
          {%- assign collection = collections[lifestylelink.handle] -%}
          {%- if collection -%}
            <a href="{{ collection.url }}" class="khas-card">
              <h3>{{ collection.title | escape }}</h3>
              <div class="khas-card-arrow">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 8h12M9 3l5 5-5 5" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 400 | image_tag: class: 'khas-card-img', loading: 'lazy', alt: collection.title }}
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <p class="khas-panel-empty">No collections added yet. Go to Admin → Navigation → mega-menu-lifestyle to add collections.</p>
      {%- endif -%}
    </div>

    <!-- Panel: Help Me Choose (Admin → Navigation → mega-menu-help) -->
    <div class="khas-grid khas-panel" data-panel="help">
      {%- assign help_menu = linklists['mega-menu-help'] -%}
      {%- if help_menu.links.size > 0 -%}
        {%- for helplink in help_menu.links -%}
          {%- assign collection = collections[helplink.handle] -%}
          {%- if collection -%}
            <a href="{{ collection.url }}" class="khas-card">
              <h3>{{ collection.title | escape }}</h3>
              <div class="khas-card-arrow">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 8h12M9 3l5 5-5 5" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 400 | image_tag: class: 'khas-card-img', loading: 'lazy', alt: collection.title }}
              {%- endif -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <p class="khas-panel-empty">No collections added yet. Go to Admin → Navigation → mega-menu-help to add collections.</p>
      {%- endif -%}
    </div>

  </div>
</div>

<script>
document.querySelectorAll('.khas-sidebar-link[data-panel]').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var panel = this.getAttribute('data-panel');
    document.querySelectorAll('.khas-sidebar-link').forEach(function(b) { b.classList.remove('active'); });
    this.classList.add('active');
    document.querySelectorAll('.khas-panel').forEach(function(p) { p.classList.remove('active'); });
    var target = document.querySelector('.khas-panel[data-panel="' + panel + '"]');
    if (target) target.classList.add('active');
  });
});
</script>
