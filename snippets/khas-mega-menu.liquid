<div class="khas-mega-menu">

  <!-- LEFT SIDEBAR -->
  <div class="khas-sidebar">
    <button class="khas-sidebar-link active" data-panel="herbs">🌿 Herbs &amp; Dried Leaves</button>
    <button class="khas-sidebar-link" data-panel="pastes">🧄 Cooking Pastes</button>
    <button class="khas-sidebar-link" data-panel="spices">🌶️ Spices &amp; Powdered</button>
    <button class="khas-sidebar-link" data-panel="whole-spices">🌰 Whole Spices</button>
    <button class="khas-sidebar-link" data-panel="salt">🧂 Salt &amp; Seasoning</button>
    <button class="khas-sidebar-link" data-panel="pasta">🍜 Pasta &amp; Noodles</button>
    <button class="khas-sidebar-link" data-panel="toppings">🧅 Crispy &amp; Cooking Toppings</button>
    <a href="{{ routes.collections_url }}" class="khas-sidebar-btn">Shop All</a>
  </div>

  <!-- RIGHT PANELS -->
  <div class="khas-panels">

    <!-- Panel 1: Herbs & Dried Leaves -->
    <div class="khas-grid khas-panel active" data-panel="herbs">
      {%- assign panel_menu = linklists['herbs-dried-leaves'] -%}
      {%- if panel_menu.links.size > 0 -%}
        {%- for menulink in panel_menu.links -%}
          {%- assign linked = menulink.object -%}
          {%- assign card_img = linked.featured_image | default: linked.products.first.featured_image -%}
          <a href="{{ menulink.url }}" class="khas-card">
            <h3>{{ menulink.title | escape }}</h3>
            <div class="khas-card-arrow">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h12M9 3l5 5-5 5" stroke="#111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            {%- if card_img -%}
              <img src="{{ card_img | image_url: width: 400 }}" class="khas-card-img" loading="lazy" width="400" height="267" alt="{{ menulink.title | escape }}">
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- else -%}
        <p class="khas-panel-empty">Add collections in Admin → Navigation → <strong>herbs-dried-leaves</strong></p>
      {%- endif -%}
    </div>

