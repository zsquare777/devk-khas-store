{% comment %}
  Renders premium Khas cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'khas-cart-drawer.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'khas-cart-drawer.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer khas-cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay khas-cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }} khas-cart-drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <!-- Top Right Botanical Decoration - Pepper Leaves -->
      <div class="khas-cart-drawer__decoration top-right">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g stroke="#3B2416" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.08">
            <!-- Pepper vine -->
            <path d="M 90,10 C 85,25 80,40 75,55 C 70,70 65,85 60,90" />
            <!-- Pepper leaves -->
            <path d="M 88,20 Q 95,15 100,20 Q 95,25 88,20 Z" fill="#3B2416" fill-opacity="0.05" />
            <path d="M 83,35 Q 90,30 95,35 Q 90,40 83,35 Z" fill="#3B2416" fill-opacity="0.05" />
            <path d="M 78,50 Q 85,45 90,50 Q 85,55 78,50 Z" fill="#3B2416" fill-opacity="0.05" />
            <!-- Tiny pepper -->
            <ellipse cx="85" cy="28" rx="4" ry="6" fill="#CD5C5C" fill-opacity="0.1" />
          </g>
        </svg>
      </div>

      <!-- Bottom Left Botanical Decoration - Coriander Sprigs -->
      <div class="khas-cart-drawer__decoration bottom-left">
        <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g stroke="#3B2416" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.08">
            <!-- Coriander stem -->
            <path d="M 10,90 C 20,80 30,75 40,70 C 50,65 60,60 70,55" />
            <!-- Coriander leaves -->
            <path d="M 15,85 Q 10,78 15,71 Q 20,78 15,85 Z" fill="#2E8B57" fill-opacity="0.06" />
            <path d="M 30,72 Q 25,65 30,58 Q 35,65 30,72 Z" fill="#2E8B57" fill-opacity="0.06" />
            <path d="M 45,62 Q 40,55 45,48 Q 50,55 45,62 Z" fill="#2E8B57" fill-opacity="0.06" />
            <path d="M 60,52 Q 55,45 60,38 Q 65,45 60,52 Z" fill="#2E8B57" fill-opacity="0.06" />
          </g>
        </svg>
      </div>

      {%- if cart == empty -%}
        <div class="khas-cart-drawer__empty">
          <div class="khas-cart-drawer__empty-content">
            <div class="khas-cart-drawer__empty-icon">
              <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 16,20 L 20,52 L 44,52 L 48,20 Z" stroke="#B08D42" stroke-width="2" fill="none"/>
                <path d="M 12,12 L 52,12" stroke="#B08D42" stroke-width="2" stroke-linecap="round"/>
                <path d="M 20,12 L 22,8 L 42,8 L 44,12" stroke="#B08D42" stroke-width="2" stroke-linecap="round"/>
                <path d="M 24,28 L 26,44" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M 32,28 L 32,44" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M 40,28 L 38,44" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="khas-cart-drawer__empty-heading">Your Cart is Empty</h2>
            <p class="khas-cart-drawer__empty-text">Add your favorite Khas Foods products and bring authentic flavor to your kitchen.</p>
            <a href="{{ routes.all_products_collection_url }}" class="khas-cart-drawer__btn khas-cart-drawer__btn--primary">
              Shop Products
            </a>
            <button
              class="khas-cart-drawer__close"
              type="button"
              onclick="this.closest('cart-drawer').close()"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 18,6 L 6,18 M 6,6 L 18,18" stroke="#3B2416" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>
      {%- endif -%}

      {%- if cart != empty -%}
        <!-- Header -->
        <div class="khas-cart-drawer__header">
          <div class="khas-cart-drawer__header-left">
            <div class="khas-cart-drawer__bag-icon">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 8,12 L 10,28 L 22,28 L 24,12 Z" stroke="#B08D42" stroke-width="1.5" fill="none"/>
                <path d="M 6,8 L 26,8" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M 12,8 L 13,5 L 19,5 L 20,8" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h2 class="khas-cart-drawer__heading">Your Cart</h2>
          </div>
          <button
            class="khas-cart-drawer__close"
            type="button"
            onclick="this.closest('cart-drawer').close()"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 18,6 L 6,18 M 6,6 L 18,18" stroke="#3B2416" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <!-- Decorative Divider -->
        <div class="khas-cart-drawer__divider">
          <div class="khas-cart-drawer__divider-line"></div>
          <div class="khas-cart-drawer__divider-flourish">
            <svg viewBox="0 0 40 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 20,2 Q 15,8 10,10 Q 15,12 20,18 Q 25,12 30,10 Q 25,8 20,2 Z" stroke="#B08D42" stroke-width="1" fill="#B08D42" fill-opacity="0.1"/>
            </svg>
          </div>
          <div class="khas-cart-drawer__divider-line"></div>
        </div>

        <!-- Cart Items -->
        <div class="khas-cart-drawer__items">
          <form
            action="{{ routes.cart_url }}"
            id="CartDrawer-Form"
            class="khas-cart-drawer__form"
            method="post"
          >
            <div id="CartDrawer-CartItems" class="khas-cart-drawer__contents js-contents">
              {%- for item in cart.items -%}
                <div class="khas-cart-drawer__item" id="CartDrawer-Item-{{ item.index | plus: 1 }}">
                  <div class="khas-cart-drawer__item-image">
                    {% if item.image %}
                      <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                        <img
                          class="khas-cart-drawer__item-img"
                          src="{{ item.image | image_url: width: 200 }}"
                          alt="{{ item.image.alt | escape }}"
                          loading="lazy"
                          width="100"
                          height="{{ 100 | divided_by: item.image.aspect_ratio | ceil }}"
                        >
                      </a>
                    {% endif %}
                  </div>

                  <div class="khas-cart-drawer__item-details">
                    <a href="{{ item.url }}" class="khas-cart-drawer__item-name">
                      {{ item.product.title | escape }}
                    </a>

                    {%- if item.product.has_only_default_variant == false -%}
                      <div class="khas-cart-drawer__item-variant">
                        {%- for option in item.options_with_values -%}
                          {{ option.name }}: {{ option.value }}{% unless forloop.last %}, {% endunless %}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                    <div class="khas-cart-drawer__item-price">
                      {%- if item.original_price != item.final_price -%}
                        <s class="khas-cart-drawer__item-old-price">{{ item.original_price | money }}</s>
                        <span class="khas-cart-drawer__item-final-price">{{ item.final_price | money }}</span>
                      {%- else -%}
                        <span>{{ item.original_price | money }}</span>
                      {%- endif -%}
                    </div>

                    <div class="khas-cart-drawer__item-actions">
                      <div class="khas-cart-drawer__quantity">
                        <button
                          type="button"
                          class="khas-cart-drawer__qty-btn khas-cart-drawer__qty-btn--minus"
                          name="minus"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          data-index="{{ item.index | plus: 1 }}"
                          {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                        >
                          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M 4,8 L 12,8" stroke="#3B2416" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        </button>
                        <input
                          type="number"
                          class="khas-cart-drawer__qty-input"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          data-index="{{ item.index | plus: 1 }}"
                          aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                          {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                        >
                        <button
                          type="button"
                          class="khas-cart-drawer__qty-btn khas-cart-drawer__qty-btn--plus"
                          name="plus"
                          data-quantity-variant-id="{{ item.variant.id }}"
                          data-index="{{ item.index | plus: 1 }}"
                          {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                        >
                          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M 8,4 L 8,12 M 4,8 L 12,8" stroke="#3B2416" stroke-width="1.5" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </div>

                      <cart-remove-button
                        id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                      >
                        <button
                          type="button"
                          class="khas-cart-drawer__remove-btn"
                          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                          data-variant-id="{{ item.variant.id }}"
                          {% if item.instructions and item.instructions.can_remove == false %}class="hidden"{% endif %}
                        >
                          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M 3,4 L 13,4 L 12,14 L 4,14 Z" stroke="#CD5C5C" stroke-width="1.5" fill="none"/>
                            <path d="M 5,4 L 5,2 L 11,2 L 11,4" stroke="#CD5C5C" stroke-width="1.5" fill="none"/>
                            <path d="M 6,6 L 6,12" stroke="#CD5C5C" stroke-width="1" stroke-linecap="round"/>
                            <path d="M 10,6 L 10,12" stroke="#CD5C5C" stroke-width="1" stroke-linecap="round"/>
                          </svg>
                        </button>
                      </cart-remove-button>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
            <div id="CartDrawer-CartErrors" role="alert"></div>
          </form>
        </div>

        <!-- Free Shipping Progress -->
        <div class="khas-cart-drawer__shipping">
          <div class="khas-cart-drawer__shipping-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 12,2 L 2,7 L 12,12 L 22,7 Z" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              <path d="M 2,17 L 12,22 L 22,17" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              <path d="M 2,7 L 2,17" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              <path d="M 22,7 L 22,17" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              <path d="M 12,12 L 12,22" stroke="#B08D42" stroke-width="1.5" fill="none"/>
            </svg>
          </div>
          <div class="khas-cart-drawer__shipping-content">
            <p class="khas-cart-drawer__shipping-text" id="khas-shipping-text">You're only £12 away from Free Shipping!</p>
            <div class="khas-cart-drawer__shipping-bar">
              <div class="khas-cart-drawer__shipping-progress" id="khas-shipping-progress"></div>
            </div>
          </div>
        </div>

        <!-- Trust Indicators -->
        <div class="khas-cart-drawer__trust">
          <div class="khas-cart-drawer__trust-item">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 10,2 L 12,8 L 18,8 L 13,12 L 15,18 L 10,14 L 5,18 L 7,12 L 2,8 L 8,8 Z" stroke="#5D7A38" stroke-width="1.5" fill="none"/>
            </svg>
            <span>Secure Checkout</span>
          </div>
          <div class="khas-cart-drawer__trust-item">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M 10,2 C 5,2 2,5 2,10 C 2,15 5,18 10,18 C 15,18 18,15 18,10 C 18,5 15,2 10,2 Z" stroke="#5D7A38" stroke-width="1.5" fill="none"/>
              <path d="M 10,6 L 10,10 L 14,14" stroke="#5D7A38" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span>Fast Dispatch</span>
          </div>
          <div class="khas-cart-drawer__trust-item">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="5" width="14" height="10" rx="1" stroke="#5D7A38" stroke-width="1.5" fill="none"/>
              <path d="M 3,8 L 10,13 L 17,8" stroke="#5D7A38" stroke-width="1.5" fill="none"/>
            </svg>
            <span>Carefully Packed</span>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="khas-cart-drawer__summary">
          <div class="khas-cart-drawer__summary-row">
            <span>Subtotal</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>
          <div class="khas-cart-drawer__summary-row">
            <span>Estimated Shipping</span>
            <span>Calculated at checkout</span>
          </div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <div class="khas-cart-drawer__summary-row khas-cart-drawer__summary-row--discount">
              <span>Discount</span>
              <span>-{{ cart.total_discount | money }}</span>
            </div>
          {%- endif -%}
          <div class="khas-cart-drawer__summary-divider"></div>
          <div class="khas-cart-drawer__summary-row khas-cart-drawer__summary-row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
        </div>

        <!-- Sticky Checkout -->
        <div class="khas-cart-drawer__footer">
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="khas-cart-drawer__btn khas-cart-drawer__btn--primary khas-cart-drawer__btn--full"
            name="checkout"
            form="CartDrawer-Form"
          >
            Proceed to Checkout
          </button>
          <a href="{{ routes.all_products_collection_url }}" class="khas-cart-drawer__btn khas-cart-drawer__btn--secondary khas-cart-drawer__btn--full">
            Continue Shopping
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>
