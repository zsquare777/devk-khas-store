<div class="huel-mega-menu">

  <!-- LEFT SIDEBAR -->
  <div class="huel-sidebar">
    <a href="#" class="sidebar-link active">Shop by Collection</a>
    <a href="#" class="sidebar-link">Shop by Goal</a>
    <a href="#" class="sidebar-link">Shop by Lifestyle</a>
    <a href="#" class="sidebar-link">Help Me Choose</a>
    <a href="{{ routes.collections_url }}" class="sidebar-button">Shop All</a>
  </div>

  <!-- RIGHT GRID -->
  <div class="huel-grid">
    {%- for childlink in link.links -%}
      {%- assign collection = collections[childlink.handle] -%}
      {%- if collection -%}
        <a href="{{ collection.url }}" class="huel-card">

          <h3>{{ collection.title | escape }}</h3>

          <div class="card-arrow">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.5 9h11M10 4.5L14.5 9 10 13.5" stroke="#111111" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          {%- if collection.featured_image -%}
            {{
              collection.featured_image
              | image_url: width: 400
              | image_tag:
                class: 'card-img',
                loading: 'lazy',
                widths: '200, 300, 400',
                alt: collection.title
            }}
          {%- endif -%}

        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

</div>
