{% comment %}
  Renders the desktop header nav with Huel-style mega menu for items with children.
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">

    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}

          {%- comment -%} ── Mega menu dropdown ── {%- endcomment -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span {%- if link.child_active %} class="header__active-menu-item"{% endif %}>
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>

              <div class="khas-mega-dropdown" tabindex="-1">
                <div class="khas-mega-dropdown__inner">

                  {%- comment -%} Left sidebar {%- endcomment -%}
                  <div class="khas-mega-dropdown__sidebar">
                    <a href="{{ link.url }}" class="khas-mega-dropdown__sidebar-link">Shop by Collection</a>
                    <a href="{{ routes.collections_url }}" class="khas-mega-dropdown__sidebar-link">Shop by Type</a>
                    <a href="/pages/contact" class="khas-mega-dropdown__sidebar-link">Help me choose</a>
                    <a href="{{ link.url }}" class="khas-mega-dropdown__shop-all">Shop all</a>
                  </div>

                  {%- comment -%} Right collection grid {%- endcomment -%}
                  <div class="khas-mega-dropdown__grid">
                    {%- for childlink in link.links -%}
                      <a href="{{ childlink.url }}" class="khas-mega-card">
                        <span class="khas-mega-card__title">{{ childlink.title | escape }}</span>
                        <div class="khas-mega-card__bottom">
                          <div class="khas-mega-card__arrow">
                            <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M3 8h10M9 4l4 4-4 4" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </div>
                        </div>
                        {%- if childlink.object.image -%}
                          {{ childlink.object.image | image_url: width: 300 | image_tag:
                              class: 'khas-mega-card__image',
                              loading: 'lazy',
                              widths: '150, 200, 300',
                              alt: childlink.title }}
                        {%- elsif childlink.object.featured_image -%}
                          {{ childlink.object.featured_image | image_url: width: 300 | image_tag:
                              class: 'khas-mega-card__image',
                              loading: 'lazy',
                              alt: childlink.title }}
                        {%- endif -%}
                      </a>
                    {%- endfor -%}
                  </div>

                </div>
              </div>

            </details>
          </header-menu>

        {%- else -%}

          {%- comment -%} ── Simple nav link ── {%- endcomment -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}aria-current="page"{% endif %}
          >
            <span {%- if link.current %} class="header__active-menu-item"{% endif %}>
              {{- link.title | escape -}}
            </span>
          </a>

        {%- endif -%}
      </li>
    {%- endfor -%}

    {%- comment -%} ── Hardcoded: Guides & Articles ── {%- endcomment -%}
    <li>
      <a
        href="/blogs/guides-and-articles"
        class="header__menu-item list-menu__item link link--text focus-inset"
        {% if request.path contains '/blogs/guides-and-articles' %}aria-current="page"{% endif %}
      >
        <span {%- if request.path contains '/blogs/guides-and-articles' %} class="header__active-menu-item"{% endif %}>
          Guides &amp; Articles
        </span>
      </a>
    </li>

  </ul>
</nav>
