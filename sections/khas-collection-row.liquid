{{ 'khas-collection-row.css' | asset_url | stylesheet_tag }}

<section class="khas-collection-row" style="background: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="khas-collection-row-inner">

    {% if section.settings.heading != blank %}
      <h2 class="khas-collection-row-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="khas-collection-row-grid">
      {% assign col = collections[section.settings.collection] %}
      {% if col != blank %}
        {% for product in col.products limit: section.settings.products_count %}
          {% assign first_variant = product.variants.first %}
          {% assign has_discount = false %}
          {% assign discount_pct = 0 %}
          {% if first_variant.compare_at_price > first_variant.price %}
            {% assign has_discount = true %}
            {% assign diff = first_variant.compare_at_price | minus: first_variant.price %}
            {% assign discount_pct = diff | times: 100 | divided_by: first_variant.compare_at_price %}
          {% endif %}

          <div class="khas-collection-row-card">
            {% if has_discount %}
              <span class="khas-collection-row-badge">-{{ discount_pct }}%</span>
            {% endif %}

            <a href="{{ product.url }}" class="khas-collection-row-img-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | default: product.title }}"
                  class="khas-collection-row-img"
                  loading="lazy"
                >
              {% else %}
                <div class="khas-collection-row-img-placeholder"></div>
              {% endif %}
            </a>

            <div class="khas-collection-row-card-body">
              <a href="{{ product.url }}" class="khas-collection-row-title">{{ product.title }}</a>

              <div class="khas-collection-row-price">
                {% if has_discount %}
                  <s class="khas-collection-row-price-compare">{{ first_variant.compare_at_price | money }}</s>
                {% endif %}
                <span class="khas-collection-row-price-current {% if has_discount %}is-sale{% endif %}">
                  {{ first_variant.price | money }}
                </span>
              </div>

              <form action="/cart/add" method="post" class="khas-collection-row-form">
                <input type="hidden" name="id" value="{{ first_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="khas-collection-row-atc">
                  Add to Cart
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <p class="khas-collection-row-empty">Select a collection in the theme editor to show products here.</p>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Khas Collection Row",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh Vegetables"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Khas Collection Row"
    }
  ]
}
{% endschema %}
