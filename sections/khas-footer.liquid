{{ 'khas-footer.css' | asset_url | stylesheet_tag }}

<footer class="khas-footer" style="
  background-color: {{ section.settings.bg_color }};
  {% if section.settings.bg_image != blank %}
  background-image: linear-gradient(rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }}), rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }})), url('{{ section.settings.bg_image | image_url: width: 2000 }}');
  background-size: cover;
  background-position: center;
  {% endif %}
">
  <div class="khas-footer-inner">

    <!-- TOP SECTION -->
    <div class="khas-footer-top">

      <!-- LEFT PANEL -->
      <div class="khas-footer-left">
        {% if section.settings.badge_image != blank %}
          <img
            src="{{ section.settings.badge_image | image_url: width: 120 }}"
            alt="Badge"
            class="khas-footer-badge"
          >
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="khas-footer-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <p class="khas-footer-subtext">{{ section.settings.subtext }}</p>
        {% endif %}
        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_link }}" class="khas-footer-btn">
            {{ section.settings.btn_text }}
          </a>
        {% endif %}
      </div>

      <!-- LINK COLUMNS -->
      <div class="khas-footer-columns">
        {% for i in (1..3) %}
          {% assign col_title_key = 'col' | append: i | append: '_title' %}
          {% assign col_menu_key  = 'col' | append: i | append: '_menu' %}
          {% assign col_title = section.settings[col_title_key] %}
          {% assign col_menu  = section.settings[col_menu_key] %}
          {% if col_title != blank or col_menu != blank %}
            <div class="khas-footer-col">
              {% if col_title != blank %}
                <h4 class="khas-footer-col-title">{{ col_title }}</h4>
              {% endif %}
              {% if col_menu != blank %}
                {% assign linklist = linklists[col_menu] %}
                {% if linklist != blank %}
                  <ul class="khas-footer-col-links">
                    {% for link in linklist.links %}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

    </div>

    <!-- DIVIDER -->
    <div class="khas-footer-divider"></div>

    <!-- MIDDLE BAR -->
    <div class="khas-footer-mid">
      <div class="khas-footer-mid-left">
        {% if section.settings.copyright != blank %}
          <span class="khas-footer-copyright">{{ section.settings.copyright }}</span>
        {% endif %}
      </div>
      <!-- PAYMENT ICONS -->
      <div class="khas-footer-payments">
        {% if section.settings.show_visa %}
          <span class="khas-footer-payment-icon" title="Visa">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#fff"/><path d="M15.8 16.4h-2.1l1.3-8h2.1l-1.3 8zm8.6-7.8c-.4-.15-.9-.3-1.6-.3-1.8 0-3 .95-3 2.3 0 1 .9 1.55 1.6 1.9.7.35.95.58.95.9 0 .48-.57.7-1.1.7-.74 0-1.13-.1-1.73-.37l-.24-.11-.26 1.6c.43.2 1.22.37 2.04.38 1.9 0 3.14-.93 3.15-2.38 0-.79-.48-1.4-1.53-1.9-.64-.32-1.03-.53-1.03-.86 0-.29.33-.6 1.05-.6.6 0 1.03.13 1.37.27l.16.08.25-1.6zm4.8-.2h-1.4c-.43 0-.75.12-.94.57l-2.66 6.4H26l.43-1.2h2.32l.25 1.2H31l-1.76-8zm-2.72 4.55l.72-1.95.18-.5.1.45.34 2h-1.34zm-11.1-4.55l-1.78 5.47-.19-.96-.63-3.24c-.11-.44-.43-.57-.82-.59h-2.9l-.03.13c.7.18 1.33.44 1.9.77l1.6 6.42h2.12l3.13-8h-2.1z" fill="#1A1F71"/></svg>
          </span>
        {% endif %}
        {% if section.settings.show_mastercard %}
          <span class="khas-footer-payment-icon" title="Mastercard">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#fff"/><circle cx="15" cy="12" r="6" fill="#EB001B"/><circle cx="23" cy="12" r="6" fill="#F79E1B"/><path d="M19 7.8a6 6 0 010 8.4A6 6 0 0119 7.8z" fill="#FF5F00"/></svg>
          </span>
        {% endif %}
        {% if section.settings.show_applepay %}
          <span class="khas-footer-payment-icon" title="Apple Pay">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#fff"/><path d="M14.3 8.5c-.4.5-1 .9-1.7.85-.08-.7.26-1.44.66-1.9.4-.48 1.1-.88 1.67-.9.07.73-.22 1.45-.63 1.95zm.62 1c-.94-.05-1.74.53-2.19.53-.45 0-1.12-.5-1.86-.49-1.96.03-3.74 1.74-3.74 4.97 0 2.07.82 4.3 1.84 5.72.87 1.22 1.62 1.77 2.4 1.77.82 0 1.17-.5 2.18-.5 1.03 0 1.3.49 2.2.49.8 0 1.56-.6 2.43-1.82.4-.57.7-1.2.9-1.76-2.1-.8-2.44-3.77-.36-4.92-.56-.77-1.43-1.04-1.8-1.04l-.8.05z" fill="#111"/></svg>
          </span>
        {% endif %}
        {% if section.settings.show_amex %}
          <span class="khas-footer-payment-icon" title="Amex">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#2557D6"/><path d="M9 9h2.2l.8 2 .8-2H15v-.01L13.5 13h-1.6L10.4 9.5V13H9V9zm6 0h4v1.2h-2.5v.8h2.4v1.1h-2.4v.8H19V14h-4V9zm4.5 0h1.7l1 1.6L23.2 9H25l-1.8 2.5 1.9 2.5h-1.8l-1.1-1.7-1.1 1.7H19l1.9-2.5L19 9h.5z" fill="#fff"/></svg>
          </span>
        {% endif %}
        {% if section.settings.show_paypal %}
          <span class="khas-footer-payment-icon" title="PayPal">
            <svg width="38" height="24" viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="4" fill="#fff"/><path d="M23.5 8c.5 1.5-.2 3.5-2.5 3.5H19l-.8 4H16l1.5-8h4.5c1 0 1.8.3 1.5.5z" fill="#009CDE"/><path d="M21 8c.3 1.2-.5 3-2.5 3H16.5L16 14H14l1.5-8H20c.8 0 1.3.3 1 0z" fill="#003087"/></svg>
          </span>
        {% endif %}
      </div>
    </div>

    <!-- DIVIDER -->
    <div class="khas-footer-divider"></div>

    <!-- BOTTOM BAR -->
    <div class="khas-footer-bottom">
      {% if section.settings.brand_name != blank %}
        <span class="khas-footer-brand">{{ section.settings.brand_name }}</span>
      {% endif %}
      <div class="khas-footer-socials">
        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" class="khas-footer-social" aria-label="YouTube" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.8 8s-.2-1.4-.8-2a2.9 2.9 0 00-2-1C17.4 4.8 12 4.8 12 4.8s-5.4 0-7 .2a2.9 2.9 0 00-2 1C2.4 6.6 2.2 8 2.2 8S2 9.6 2 11.2v1.5c0 1.6.2 3.2.2 3.2s.2 1.4.8 2a3 3 0 002 1c1.6.1 6.9.2 6.9.2s5.4 0 7-.2a2.9 2.9 0 002-1c.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.5C22 9.6 21.8 8 21.8 8zM9.7 14.8V9.1l5.6 2.9-5.6 2.8z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" class="khas-footer-social" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.twitter_url != blank %}
          <a href="{{ section.settings.twitter_url }}" class="khas-footer-social" aria-label="X / Twitter" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.3 5H21l-5.6 6.4L22 19h-5.1l-3.8-5-4.4 5H6l6-6.8L2 5h5.3l3.5 4.6L18.3 5zm-1 12.3h1.5L6.7 6.5H5.1l12.2 10.8z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.linkedin_url != blank %}
          <a href="{{ section.settings.linkedin_url }}" class="khas-footer-social" aria-label="LinkedIn" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2zm2-6a2 2 0 110 4 2 2 0 010-4z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" class="khas-footer-social" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 3h-3v11.4a2.4 2.4 0 11-2.4-2.4c.2 0 .5 0 .7.1V9a5.7 5.7 0 101.7 4V3h3z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="khas-footer-social" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.legal_text != blank %}
      <div class="khas-footer-legal">
        <p>{{ section.settings.legal_text }}</p>
      </div>
    {% endif %}

  </div>
</footer>

{% schema %}
{
  "name": "Khas Footer",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 60
    },
    {
      "type": "header",
      "content": "Left panel"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Badge / certification image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Quality nutrition, crafted for a healthier life."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "All Khas products are crafted with quality ingredients and care."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "See our story"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Link Column 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Column 1 heading",
      "default": "Food"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column 1 menu"
    },
    {
      "type": "header",
      "content": "Link Column 2"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column 2 menu"
    },
    {
      "type": "header",
      "content": "Link Column 3"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "Column 3 menu"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2025 Khas Foods Ltd. All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Show Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Show Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_applepay",
      "label": "Show Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "Show Amex",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paypal",
      "label": "Show PayPal",
      "default": true
    },
    {
      "type": "header",
      "content": "Brand & social"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Khas®"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "textarea",
      "id": "legal_text",
      "label": "Legal / disclaimer text"
    }
  ],
  "presets": [
    {
      "name": "Khas Footer"
    }
  ]
}
{% endschema %}
