{{ 'khas-footer.css' | asset_url | stylesheet_tag }}

<footer class="khas-footer" id="KhasFooterSection">
  
  <!-- Left Corner Botanical Overlay -->
  <svg class="khas-footer-corner-overlay left" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M -10,150 C 40,140 80,100 60,60 C 50,40 20,30 0,50 C -15,65 -5,110 30,100" stroke="#bf9252" stroke-width="1.2" opacity="0.08" />
    <path d="M 12,80 Q 40,50 60,70 Q 30,100 12,80 Z" fill="#bf9252" opacity="0.04" />
    <path d="M 28,110 Q 60,85 75,105 Q 45,130 28,110 Z" fill="#bf9252" opacity="0.04" />
  </svg>

  <!-- Right Corner Botanical Overlay -->
  <svg class="khas-footer-corner-overlay right" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M -10,150 C 40,140 80,100 60,60 C 50,40 20,30 0,50 C -15,65 -5,110 30,100" stroke="#bf9252" stroke-width="1.2" opacity="0.08" />
    <path d="M 12,80 Q 40,50 60,70 Q 30,100 12,80 Z" fill="#bf9252" opacity="0.04" />
    <path d="M 28,110 Q 60,85 75,105 Q 45,130 28,110 Z" fill="#bf9252" opacity="0.04" />
  </svg>

  <div class="khas-footer-inner">
    
    <!-- Top Divider Line with leaf spray -->
    <div class="khas-footer-top-divider">
      <div class="khas-footer-top-line"></div>
      <div class="khas-footer-top-leaf">
        <svg viewBox="0 0 40 30" width="30" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 20,24 C 20,15 17,10 13,6 C 17,9 20,14 20,24 Z" fill="#bf9252" />
          <path d="M 20,24 C 20,15 23,10 27,6 C 23,9 20,14 20,24 Z" fill="#bf9252" />
          <path d="M 20,24 C 20,12 20,6 20,2 C 20,6 20,12 20,24 Z" stroke="#bf9252" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="khas-footer-grid">
      
      <!-- Column 1: Brand & Highlights -->
      <div class="khas-footer-brand-col">
        {%- if settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="khas-footer-logo-link">
            {{ settings.logo | image_url: width: 300 | image_tag: class: 'khas-footer-logo-img', alt: shop.name }}
          </a>
        {%- else -%}
          <h2 class="khas-footer-logo-text">{{ shop.name }}</h2>
        {%- endif -%}
        
        <p class="khas-footer-desc">
          Bringing you authentic spices and food products made with quality ingredients and care.
        </p>
        
        <span class="khas-footer-motto">Authentic. Pure. Khas.</span>

        <!-- 4 Highlights -->
        <div class="khas-footer-highlights">
          <!-- Highlight 1: 100% Natural -->
          <div class="khas-footer-highlight">
            <div class="khas-highlight-circle">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 6,18 C 6,12 10,8 18,6 C 15,12 12,15 6,18 Z" stroke="#bf9252" stroke-width="1.5" fill="none" />
                <path d="M 6,18 Q 12,12 18,6" stroke="#bf9252" stroke-width="1" />
              </svg>
            </div>
            <span class="khas-highlight-label">100%<br>Natural</span>
          </div>

          <!-- Highlight 2: Premium Quality -->
          <div class="khas-footer-highlight">
            <div class="khas-highlight-circle">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 6,13 C 6,17 9,19 12,19 C 15,19 18,17 18,13 L 19,10 L 5,10 Z" stroke="#bf9252" stroke-width="1.5" stroke-linejoin="round" fill="none" />
                <path d="M 10,19 L 14,19 L 15,21 L 9,21 Z" fill="#bf9252" />
                <path d="M 13.5,8 L 17,4 C 17.5,3.5 19,4.5 18,5 L 15.5,10 Z" stroke="#bf9252" stroke-width="1.5" stroke-linejoin="round" fill="#bf9252" />
              </svg>
            </div>
            <span class="khas-highlight-label">Premium<br>Quality</span>
          </div>

          <!-- Highlight 3: Trusted Brand -->
          <div class="khas-footer-highlight">
            <div class="khas-highlight-circle">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 10,16 L 7,22 L 11,20 L 12,16 Z" stroke="#bf9252" stroke-width="1.2" fill="none" stroke-linejoin="round" />
                <path d="M 14,16 L 17,22 L 13,20 L 12,16 Z" stroke="#bf9252" stroke-width="1.2" fill="none" stroke-linejoin="round" />
                <circle cx="12" cy="11" r="5.5" stroke="#bf9252" stroke-width="1.5" fill="#0d0b0a" />
                <polygon points="12,8 13,10.5 15.5,10.5 13.5,12 14.5,14.5 12,13 9.5,14.5 10.5,12 8.5,10.5 11,10.5" fill="#bf9252" />
              </svg>
            </div>
            <span class="khas-highlight-label">Trusted<br>Brand</span>
          </div>

          <!-- Highlight 4: Made in Canada -->
          <div class="khas-footer-highlight">
            <div class="khas-highlight-circle">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 12,2 L 13.5,6.5 L 15.5,5.5 L 15,7.5 L 18.5,7.5 L 17.5,9.5 L 21.5,10.5 L 19.5,12.5 L 21.5,14 L 17.5,14 L 18,16 L 15,15 L 15,18 L 12,16.5 L 9,18 L 9,15 L 6,16 L 6.5,14 L 2.5,14 L 4.5,12.5 L 2.5,10.5 L 6.5,9.5 L 5.5,7.5 L 9,7.5 L 8.5,5.5 L 10.5,6.5 Z M 12,16.5 L 12,22" stroke="#bf9252" stroke-width="1.5" stroke-linejoin="round" fill="none" />
              </svg>
            </div>
            <span class="khas-highlight-label">Made in<br>Canada</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Shop links -->
      <div class="khas-footer-col">
        <h4 class="khas-footer-col-title">Shop</h4>
        <div class="khas-footer-col-divider"></div>
        <ul class="khas-footer-col-links">
          {%- assign shop_menu = section.settings.col1_menu -%}
          {%- if shop_menu != blank and linklists[shop_menu] != blank -%}
            {%- for link in linklists[shop_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/collections/all">All Products</a></li>
            <li><a href="/collections/all">Bestsellers</a></li>
            <li><a href="/collections/all">New Arrivals</a></li>
            <li><a href="/collections/all">Spices & Seasonings</a></li>
            <li><a href="/collections/all">Rice & Grains</a></li>
            <li><a href="/collections/all">Flours</a></li>
            <li><a href="/collections/all">Cooking Essentials</a></li>
            <li><a href="/collections/all">Gift Packs</a></li>
            <li><a href="/collections/all">Sale</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: Company links -->
      <div class="khas-footer-col">
        <h4 class="khas-footer-col-title">Company</h4>
        <div class="khas-footer-col-divider"></div>
        <ul class="khas-footer-col-links">
          {%- assign company_menu = section.settings.col2_menu -%}
          {%- if company_menu != blank and linklists[company_menu] != blank -%}
            {%- for link in linklists[company_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/about-us">About Us</a></li>
            <li><a href="/pages/about-us">Our Story</a></li>
            <li><a href="/pages/about-us">Why Khas?</a></li>
            <li><a href="/blogs/news">Blog</a></li>
            <li><a href="/pages/about-us">Careers</a></li>
            <li><a href="/pages/about-us">Wholesale</a></li>
            <li><a href="/pages/about-us">Contact Us</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 4: Support links -->
      <div class="khas-footer-col">
        <h4 class="khas-footer-col-title">Support</h4>
        <div class="khas-footer-col-divider"></div>
        <ul class="khas-footer-col-links">
          {%- assign support_menu = section.settings.col3_menu -%}
          {%- if support_menu != blank and linklists[support_menu] != blank -%}
            {%- for link in linklists[support_menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/about-us">Shipping & Delivery</a></li>
            <li><a href="/pages/about-us">Returns & Refunds</a></li>
            <li><a href="/pages/about-us">Payment Options</a></li>
            <li><a href="/pages/about-us">FAQs</a></li>
            <li><a href="/pages/about-us">Track Your Order</a></li>
            <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service">Terms & Conditions</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 5: Stay Connected & Payment -->
      <div class="khas-footer-connect-col">
        <h4 class="khas-footer-col-title">Stay Connected</h4>
        <div class="khas-footer-col-divider"></div>
        <p class="khas-footer-newsletter-text">
          Subscribe to our newsletter and get the latest updates, offers & recipes.
        </p>

        <!-- Newsletter form -->
        {%- form 'customer', class: 'footer-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer-newsletter-input-group">
            <input
              type="email"
              name="contact[email]"
              class="footer-newsletter-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Enter your email"
              required
            >
            <button type="submit" class="footer-newsletter-btn" aria-label="Subscribe">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 3,8 L 13,8 M 9,4 L 13,8 L 9,12" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        {%- endform -%}

        <!-- Social icons -->
        <div class="khas-footer-social-icons">
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" class="khas-footer-social-icon" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="khas-footer-social-icon" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" class="khas-footer-social-icon" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z" /><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" /></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="khas-footer-social-icon" aria-label="TikTok" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" /></svg>
            </a>
          {%- endif -%}
        </div>

        <!-- Payment Cards Section -->
        <div class="khas-footer-payment-section">
          <h4 class="khas-footer-col-title">We Accept</h4>
          <div class="khas-footer-col-divider"></div>
          <div class="khas-footer-payments">
            {% if section.settings.show_visa %}
              <div class="khas-footer-payment-card" title="Visa">
                <svg viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M15.8 16.4h-2.1l1.3-8h2.1l-1.3 8zm8.6-7.8c-.4-.15-.9-.3-1.6-.3-1.8 0-3 .95-3 2.3 0 1 .9 1.55 1.6 1.9.7.35.95.58.95.9 0 .48-.57.7-1.1.7-.74 0-1.13-.1-1.73-.37l-.24-.11-.26 1.6c.43.2 1.22.37 2.04.38 1.9 0 3.14-.93 3.15-2.38 0-.79-.48-1.4-1.53-1.9-.64-.32-1.03-.53-1.03-.86 0-.29.33-.6 1.05-.6.6 0 1.03.13 1.37.27l.16.08.25-1.6zm4.8-.2h-1.4c-.43 0-.75.12-.94.57l-2.66 6.4H26l.43-1.2h2.32l.25 1.2H31l-1.76-8zm-2.72 4.55l.72-1.95.18-.5.1.45.34 2h-1.34zm-11.1-4.55l-1.78 5.47-.19-.96-.63-3.24c-.11-.44-.43-.57-.82-.59h-2.9l-.03.13c.7.18 1.33.44 1.9.77l1.6 6.42h2.12l3.13-8h-2.1z" fill="#1A1F71"/>
                </svg>
              </div>
            {% endif %}
            {% if section.settings.show_mastercard %}
              <div class="khas-footer-payment-card" title="Mastercard">
                <svg viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="15" cy="12" r="6" fill="#EB001B"/>
                  <circle cx="23" cy="12" r="6" fill="#F79E1B"/>
                  <path d="M19 7.8a6 6 0 0 1 0 8.4A6 6 0 0 1 19 7.8z" fill="#FF5F00"/>
                </svg>
              </div>
            {% endif %}
            {% if section.settings.show_amex %}
              <div class="khas-footer-payment-card" title="Amex">
                <svg viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="38" height="24" rx="2" fill="#2557D6"/>
                  <path d="M9 9h2.2l.8 2 .8-2H15v-.01L13.5 13h-1.6L10.4 9.5V13H9V9zm6 0h4v1.2h-2.5v.8h2.4v1.1h-2.4v.8H19V14h-4V9zm4.5 0h1.7l1 1.6L23.2 9H25l-1.8 2.5 1.9 2.5h-1.8l-1.1-1.7-1.1 1.7H19l1.9-2.5L19 9h.5z" fill="#fff"/>
                </svg>
              </div>
            {% endif %}
            {% if section.settings.show_applepay %}
              <div class="khas-footer-payment-card" title="Apple Pay">
                <svg viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10.8 8.1c-.2.3-.5.5-.9.5-.04-.4.13-.8.33-1.1.2-.28.56-.5.85-.5.03.41-.11.82-.28 1.1zm.31.56c-.47-.02-.87.27-1.1.27-.22 0-.56-.25-.93-.25-.98.02-1.87.87-1.87 2.49 0 1.03.41 2.15.92 2.86.43.61.81.88 1.2.88.41 0 .58-.25 1.09-.25.52 0 .65.25 1.1.25.4 0 .78-.3 1.22-.91.2-.28.35-.6.45-.88-1.05-.4-1.22-1.88-.18-2.46-.28-.39-.71-.52-.9-.52l-.4.05zm7.39 1.48c0-1.52.88-2.28 2.25-2.28.67 0 1.23.23 1.57.65l-.76.6c-.23-.27-.51-.39-.81-.39-.77 0-1.22.51-1.22 1.42v.01c0 .91.45 1.42 1.22 1.42.3 0 .58-.12.81-.39l.76.6c-.34.42-.9.65-1.57.65-1.37 0-2.25-.76-2.25-2.28zm8.6-2.14l-1.92 5.09h-.94l.58-1.52-1.56-3.57h.99l1.01 2.53 1.01-2.53h.83z" fill="#000" />
                </svg>
              </div>
            {% endif %}
            {% if section.settings.show_paypal %}
              <div class="khas-footer-payment-card" title="PayPal">
                <svg viewBox="0 0 38 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M23.5 8c.5 1.5-.2 3.5-2.5 3.5H19l-.8 4H16l1.5-8h4.5c1 0 1.8.3 1.5.5z" fill="#009CDE"/>
                  <path d="M21 8c.3 1.2-.5 3-2.5 3H16.5L16 14H14l1.5-8H20c.8 0 1.3.3 1 0z" fill="#003087"/>
                </svg>
              </div>
            {% endif %}
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Line divider with leaf spray -->
    <div class="khas-footer-bottom-divider">
      <div class="khas-footer-bottom-line"></div>
      <div class="khas-footer-bottom-leaf">
        <svg viewBox="0 0 40 30" width="30" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 20,24 C 20,15 17,10 13,6 C 17,9 20,14 20,24 Z" fill="#bf9252" />
          <path d="M 20,24 C 20,15 23,10 27,6 C 23,9 20,14 20,24 Z" fill="#bf9252" />
          <path d="M 20,24 C 20,12 20,6 20,2 C 20,6 20,12 20,24 Z" stroke="#bf9252" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </div>
    </div>

    <!-- Copyright Text -->
    <div class="khas-footer-copyright-bar">
      <p class="khas-footer-copyright-text">
        &copy; {{ 'now' | date: '%Y' }} Khas Foods Ltd. All Rights Reserved.
      </p>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Khas Footer",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#070605"
    },
    {
      "type": "header",
      "content": "Link Column 1"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Column 1 heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column 1 menu"
    },
    {
      "type": "header",
      "content": "Link Column 2"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 heading",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column 2 menu"
    },
    {
      "type": "header",
      "content": "Link Column 3"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "col3_menu",
      "label": "Column 3 menu"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2025 Khas Foods Ltd. All Rights Reserved."
    },
    {
      "type": "checkbox",
      "id": "show_visa",
      "label": "Show Visa",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mastercard",
      "label": "Show Mastercard",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_applepay",
      "label": "Show Apple Pay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_amex",
      "label": "Show Amex",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paypal",
      "label": "Show PayPal",
      "default": true
    },
    {
      "type": "header",
      "content": "Brand & social"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ],
  "presets": [
    {
      "name": "Khas Footer"
    }
  ]
}
{% endschema %}
