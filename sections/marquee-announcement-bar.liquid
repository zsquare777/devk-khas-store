{%- style -%}
  .marquee-bar-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
    padding: {{ section.settings.bar_padding }}px 0;
    position: relative;
    cursor: default;
  }

  .marquee-bar-{{ section.id }} .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-{{ section.id }} {{ section.settings.scroll_speed }}s linear infinite;
  }

  .marquee-bar-{{ section.id }} .marquee-set {
    display: inline-flex;
    align-items: center;
  }

  .marquee-bar-{{ section.id }} .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.icon_gap }}px;
    padding: 0 {{ section.settings.item_gap }}px;
    white-space: nowrap;
    color: {{ section.settings.text_color }};
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    letter-spacing: {{ section.settings.letter_spacing }}px;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
  }

  .marquee-bar-{{ section.id }} a.marquee-item {
    cursor: pointer;
  }

  .marquee-bar-{{ section.id }} .marquee-item__icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marquee-bar-{{ section.id }} .marquee-item__icon svg {
    width: 100%;
    height: 100%;
    fill: {{ section.settings.text_color }};
    display: block;
  }

  .marquee-bar-{{ section.id }} .marquee-item__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: {{ section.settings.icon_filter }};
  }

  .marquee-bar-{{ section.id }} .marquee-divider {
    display: inline-block;
    width: 1px;
    height: 1em;
    background-color: {{ section.settings.text_color }};
    opacity: 0.3;
    flex-shrink: 0;
  }

  @keyframes marquee-{{ section.id }} {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
{%- endstyle -%}


<div
  class="marquee-bar marquee-bar-{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Announcements' }}"
  id="MarqueeBar-{{ section.id }}"
>
  <div class="marquee-track" id="MarqueeTrack-{{ section.id }}">
    {%- for run in (1..2) -%}
      <div class="marquee-set"{% if run == 2 %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_link = false
            if block.settings.link != blank
              assign is_link = true
            endif
            assign chosen_icon = block.settings.icon_preset
          -%}

          {%- if is_link -%}
            <a href="{{ block.settings.link }}" class="marquee-item" {%- if run == 1 -%}{{ block.shopify_attributes }}{%- endif -%}>
          {%- else -%}
            <div class="marquee-item" {%- if run == 1 -%}{{ block.shopify_attributes }}{%- endif -%}>
          {%- endif -%}

          {%- comment -%} Icon: uploaded image takes priority over preset {%- endcomment -%}
          {%- if block.settings.icon_image != blank -%}
            <span class="marquee-item__icon">
              <img
                src="{{ block.settings.icon_image | image_url: width: 60 }}"
                alt="{{ block.settings.icon_image.alt | default: '' | escape }}"
                width="{{ section.settings.icon_size }}"
                height="{{ section.settings.icon_size }}"
                loading="lazy"
              >
            </span>
          {%- elsif chosen_icon != 'none' and chosen_icon != blank -%}
            <span class="marquee-item__icon">
              {%- case chosen_icon -%}
                {%- when 'loyalty' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>
                {%- when 'person' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-1.5 1.5l1.96 2.5H17V9.5h1.5zM6 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2.22-3c-.55-.61-1.33-1-2.22-1s-1.67.39-2.22 1H3V6h12v9H8.22zM18 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/></svg>
                {%- when 'mail' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                {%- when 'gift' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 6h-2.18c.07-.26.18-.51.18-.78C18 3.22 16.78 2 15.22 2c-.95 0-1.78.47-2.34 1.19L12 4.33l-.88-1.14C10.56 2.47 9.73 2 8.78 2 7.22 2 6 3.22 6 4.78c0 .27.11.52.18.78H4c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-4.78-2c.44 0 .78.34.78.78s-.34.78-.78.78H13l1.2-1.56c.2-.26.5-.22.8-.22zm-6.44 0c.3 0 .6-.04.8.22L11 5.56H8.78c-.44 0-.78-.34-.78-.78S7.34 4 7.78 4zM4 12v8c0 1.1.9 2 2 2h5v-9H4zm9 0v9h5c1.1 0 2-.9 2-2v-8h-7z"/></svg>
                {%- when 'tag' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58s1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41s-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2s.07-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z"/></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}

          <span class="marquee-item__text">{{ block.settings.text | escape }}</span>

          {%- if is_link -%}</a>{%- else -%}</div>{%- endif -%}

          {%- unless forloop.last -%}
            {%- if section.settings.show_dividers -%}
              <span class="marquee-divider" aria-hidden="true"></span>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var bar   = document.getElementById('MarqueeBar-{{ section.id }}');
    var track = document.getElementById('MarqueeTrack-{{ section.id }}');
    if (!bar || !track) return;

    var currentText = null;

    function setUnderline(textEl, on) {
      if (!textEl) return;
      textEl.style.setProperty('text-decoration', on ? 'underline' : 'none', 'important');
      textEl.style.setProperty('text-underline-offset', '3px', 'important');
    }

    function getTextEl(target) {
      if (!target || !target.closest) return null;
      var item = target.closest('.marquee-item');
      return item ? item.querySelector('.marquee-item__text') : null;
    }

    bar.addEventListener('mouseenter', function () {
      track.style.animationPlayState = 'paused';
    });

    bar.addEventListener('mouseleave', function () {
      track.style.animationPlayState = 'running';
      setUnderline(currentText, false);
      currentText = null;
    });

    bar.addEventListener('mouseover', function (e) {
      var textEl = getTextEl(e.target);
      if (textEl === currentText) return;
      setUnderline(currentText, false);
      currentText = textEl;
      setUnderline(currentText, true);
    });
  })();
</script>

{% schema %}
{
  "name": "Marquee Announcement Bar",
  "class": "marquee-announcement-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "icon_filter",
      "label": "Icon image tint",
      "info": "Only applies to uploaded images, not preset icons",
      "options": [
        { "value": "none", "label": "None (original color)" },
        { "value": "brightness(0) invert(1)", "label": "White" },
        { "value": "brightness(0)", "label": "Black" }
      ],
      "default": "brightness(0) invert(1)"
    },
    {
      "type": "header",
      "content": "Scroll"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "label": "Scroll speed (lower = faster)",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "bar_padding",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bar top/bottom padding",
      "default": 18
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show dividers between items",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Letter spacing",
      "default": 1
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_gap",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap between icon and text",
      "default": 8
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Screen reader label",
      "default": "Announcements"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Announcement item",
      "settings": [
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icon",
          "info": "Choose a built-in icon. Upload an image below to override.",
          "options": [
            { "value": "none",    "label": "None" },
            { "value": "loyalty", "label": "Loyalty / Plus" },
            { "value": "person",  "label": "Person / User" },
            { "value": "truck",   "label": "Delivery Truck" },
            { "value": "mail",    "label": "Subscribe / Mail" },
            { "value": "star",    "label": "Star / Reward" },
            { "value": "gift",    "label": "Gift" },
            { "value": "tag",     "label": "Discount Tag" },
            { "value": "globe",   "label": "Globe / Country" },
            { "value": "check",   "label": "Checkmark" },
            { "value": "heart",   "label": "Heart" }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Overrides the preset icon above. PNG or SVG with transparency recommended."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free express delivery on orders 45+"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Announcement Bar",
      "blocks": [
        {
          "type": "item",
          "settings": { "icon_preset": "loyalty", "text": "Huel+ Loyalty Programme" }
        },
        {
          "type": "item",
          "settings": { "icon_preset": "person", "text": "Give 20, Get 20" }
        },
        {
          "type": "item",
          "settings": { "icon_preset": "truck", "text": "Free Express Delivery on Orders 45+" }
        },
        {
          "type": "item",
          "settings": { "icon_preset": "mail", "text": "Subscribe and Save 10%" }
        }
      ]
    }
  ]
}
{% endschema %}
