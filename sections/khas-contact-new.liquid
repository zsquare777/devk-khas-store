{{ 'khas-contact-new.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .khas-contact-new-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="khas-contact-new khas-contact-new-{{ section.id }}" id="KhasContactNewSection">
  
  <!-- Hero Section -->
  <div class="khas-contact-new-hero">
    <!-- Top Left Botanical Decoration - Olive Branch -->
    <div class="khas-contact-new-decoration top-left">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3B2416" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
          <!-- Olive branch -->
          <path d="M 20,100 C 50,90 80,100 110,90 C 140,80 170,90 180,80" />
          <!-- Olives -->
          <ellipse cx="40" cy="95" rx="6" ry="8" fill="#3B2416" fill-opacity="0.08" />
          <ellipse cx="70" cy="95" rx="6" ry="8" fill="#3B2416" fill-opacity="0.08" />
          <ellipse cx="100" cy="85" rx="6" ry="8" fill="#3B2416" fill-opacity="0.08" />
          <ellipse cx="130" cy="85" rx="6" ry="8" fill="#3B2416" fill-opacity="0.08" />
          <ellipse cx="160" cy="85" rx="6" ry="8" fill="#3B2416" fill-opacity="0.08" />
          <!-- Small leaves -->
          <path d="M 35,88 Q 30,83 35,78 Q 40,83 35,88 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 65,88 Q 60,83 65,78 Q 70,83 65,88 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 95,78 Q 90,73 95,68 Q 100,73 95,78 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 125,78 Q 120,73 125,68 Q 130,73 125,78 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 155,78 Q 150,73 155,68 Q 160,73 155,78 Z" fill="#3B2416" fill-opacity="0.06" />
        </g>
      </svg>
    </div>

    <!-- Bottom Right Botanical Decoration - Herb Vine -->
    <div class="khas-contact-new-decoration bottom-right">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3B2416" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
          <!-- Herb vine -->
          <path d="M 180,20 C 170,40 160,60 150,80 C 140,100 130,120 120,140 C 110,160 100,180 90,180" />
          <!-- Leaves -->
          <path d="M 175,35 Q 185,30 195,35 Q 185,40 175,35 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 165,55 Q 175,50 185,55 Q 175,60 165,55 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 155,75 Q 165,70 175,75 Q 165,80 155,75 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 145,95 Q 155,90 165,95 Q 155,100 145,95 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 135,115 Q 145,110 155,115 Q 145,120 135,115 Z" fill="#3B2416" fill-opacity="0.06" />
          <!-- Small blossoms -->
          <circle cx="170" cy="30" r="3" fill="#B08D42" fill-opacity="0.1" />
          <circle cx="160" cy="50" r="3" fill="#B08D42" fill-opacity="0.1" />
          <circle cx="150" cy="70" r="3" fill="#B08D42" fill-opacity="0.1" />
        </g>
      </svg>
    </div>

    <div class="khas-contact-new-hero-content">
      <div class="khas-contact-new-crown">
        <svg viewBox="0 0 100 35" width="120" height="42" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 40,30 L 60,30 L 62,24 L 56,26 L 50,15 L 44,26 L 38,24 Z" fill="#fabd2f" />
          <circle cx="50" cy="13" r="1.5" fill="#fabd2f" />
          <circle cx="38" cy="22" r="1" fill="#fabd2f" />
          <circle cx="62" cy="22" r="1" fill="#fabd2f" />
          <path d="M 42,28 Q 50,29 58,28" stroke="#fabd2f" stroke-width="1" />
        </svg>
      </div>
      <h1 class="khas-contact-new-hero-heading">Contact Us</h1>
      <p class="khas-contact-new-hero-subheading">We'd love to hear from you. Whether you have a question about our products, your order, or wholesale opportunities, our team is here to help.</p>
      <div class="khas-contact-new-hero-buttons">
        <a href="#contact-form" class="khas-contact-new-btn khas-contact-new-btn--primary">Get in Touch</a>
        <a href="/collections/all" class="khas-contact-new-btn khas-contact-new-btn--secondary">Shop Products</a>
      </div>
    </div>
  </div>

  <!-- Main Contact Section -->
  <div class="khas-contact-new-section">
    <div class="khas-contact-new-grid">
      <!-- Left Side - Contact Information -->
      <div class="khas-contact-new-info">
        <div class="khas-contact-new-info-card">
          <h2 class="khas-contact-new-info-heading">Contact Information</h2>
          
          <div class="khas-contact-new-info-item">
            <div class="khas-contact-new-info-icon">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 4,8 L 28,8 L 28,24 L 4,24 Z" stroke="#B08D42" stroke-width="1.5" fill="none"/>
                <path d="M 4,8 L 16,16 L 28,8" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div class="khas-contact-new-info-content">
              <p class="khas-contact-new-info-label">Email</p>
              <a href="mailto:info@khasfoods.co.uk" class="khas-contact-new-info-value">info@khasfoods.co.uk</a>
            </div>
          </div>
          
          <div class="khas-contact-new-info-item">
            <div class="khas-contact-new-info-icon">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 6,6 C 6,4 8,4 8,4 L 24,4 C 24,4 26,4 26,6 L 26,26 C 26,28 24,28 24,28 L 8,28 C 8,28 6,28 6,26 Z" stroke="#B08D42" stroke-width="1.5" fill="none"/>
                <path d="M 6,10 L 16,18 L 26,10" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div class="khas-contact-new-info-content">
              <p class="khas-contact-new-info-label">Phone</p>
              <a href="tel:+447886273549" class="khas-contact-new-info-value">+44 7886 273549</a>
            </div>
          </div>
          
          <div class="khas-contact-new-info-item">
            <div class="khas-contact-new-info-icon">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 16,4 C 9,4 4,9 4,16 C 4,23 9,28 16,28 C 23,28 28,23 28,16 C 28,9 23,4 16,4 Z" stroke="#B08D42" stroke-width="1.5" fill="none"/>
                <path d="M 16,8 L 16,16 L 22,22" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="khas-contact-new-info-content">
              <p class="khas-contact-new-info-label">Address</p>
              <p class="khas-contact-new-info-value">2 Frederick Street, King's Cross<br>London, WC1X 0ND</p>
            </div>
          </div>
          
          <div class="khas-contact-new-info-item">
            <div class="khas-contact-new-info-icon">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="8" width="24" height="16" rx="2" stroke="#B08D42" stroke-width="1.5" fill="none"/>
                <path d="M 4,12 L 16,20 L 28,12" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              </svg>
            </div>
            <div class="khas-contact-new-info-content">
              <p class="khas-contact-new-info-label">Company</p>
              <p class="khas-contact-new-info-value">KHAS FOODS LIMITED</p>
            </div>
          </div>
        </div>
        
        <!-- Business Hours Card -->
        <div class="khas-contact-new-hours-card">
          <div class="khas-contact-new-hours-icon">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="16" cy="16" r="12" stroke="#B08D42" stroke-width="1.5" fill="none"/>
              <path d="M 16,8 L 16,16 L 22,20" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="khas-contact-new-hours-content">
            <h3 class="khas-contact-new-hours-heading">Business Hours</h3>
            <p class="khas-contact-new-hours-text">Monday – Friday: 9:00 AM – 5:00 PM</p>
            <p class="khas-contact-new-hours-text">Saturday: Closed</p>
            <p class="khas-contact-new-hours-text">Sunday: Closed</p>
          </div>
        </div>
      </div>
      
      <!-- Right Side - Contact Form -->
      <div class="khas-contact-new-form-wrapper" id="contact-form">
        <div class="khas-contact-new-form-card">
          <h2 class="khas-contact-new-form-heading">Send Us a Message</h2>
          
          {% form 'contact' %}
            <div class="khas-contact-new-form-group">
              <label for="ContactName" class="khas-contact-new-form-label">Full Name</label>
              <input type="text" name="contact[name]" id="ContactName" class="khas-contact-new-form-input" required placeholder="Your full name" />
            </div>
            
            <div class="khas-contact-new-form-group">
              <label for="ContactEmail" class="khas-contact-new-form-label">Email Address</label>
              <input type="email" name="contact[email]" id="ContactEmail" class="khas-contact-new-form-input" required placeholder="your@email.com" />
            </div>
            
            <div class="khas-contact-new-form-group">
              <label for="ContactPhone" class="khas-contact-new-form-label">Phone Number (optional)</label>
              <input type="tel" name="contact[phone]" id="ContactPhone" class="khas-contact-new-form-input" placeholder="+44 7XXX XXXXXX" />
            </div>
            
            <div class="khas-contact-new-form-group">
              <label for="ContactSubject" class="khas-contact-new-form-label">Subject</label>
              <select name="contact[subject]" id="ContactSubject" class="khas-contact-new-form-input" required>
                <option value="">Select a subject</option>
                <option value="Product Enquiry">Product Enquiry</option>
                <option value="Order Support">Order Support</option>
                <option value="Wholesale Enquiry">Wholesale Enquiry</option>
                <option value="General Information">General Information</option>
                <option value="Other">Other</option>
              </select>
            </div>
            
            <div class="khas-contact-new-form-group">
              <label for="ContactMessage" class="khas-contact-new-form-label">Message</label>
              <textarea name="contact[body]" id="ContactMessage" class="khas-contact-new-form-textarea" rows="5" required placeholder="How can we help you?"></textarea>
            </div>
            
            <button type="submit" class="khas-contact-new-btn khas-contact-new-btn--primary khas-contact-new-btn--full">Send Message</button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>

  <!-- Why Contact Us -->
  <div class="khas-contact-new-section">
    <div class="khas-contact-new-section-header">
      <h2 class="khas-contact-new-section-heading">How Can We Help?</h2>
      <div class="khas-contact-new-divider"></div>
    </div>
    <div class="khas-contact-new-cards-grid">
      <div class="khas-contact-new-card">
        <div class="khas-contact-new-card-icon">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="14" stroke="#B08D42" stroke-width="1.5" fill="none"/>
            <path d="M 20,12 L 20,20 L 26,26" stroke="#B08D42" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="khas-contact-new-card-heading">Customer Support</h3>
        <p class="khas-contact-new-card-text">Questions about products or orders.</p>
      </div>
      <div class="khas-contact-new-card">
        <div class="khas-contact-new-card-icon">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="12" width="24" height="16" rx="2" stroke="#B08D42" stroke-width="1.5" fill="none"/>
            <path d="M 8,16 L 20,24 L 32,16" stroke="#B08D42" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
        <h3 class="khas-contact-new-card-heading">Wholesale Enquiries</h3>
        <p class="khas-contact-new-card-text">Interested in becoming a retail or wholesale partner.</p>
      </div>
      <div class="khas-contact-new-card">
        <div class="khas-contact-new-card-icon">
          <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M 20,4 L 24,14 L 34,14 L 26,20 L 29,30 L 20,24 L 11,30 L 14,20 L 6,14 L 16,14 Z" stroke="#B08D42" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
        <h3 class="khas-contact-new-card-heading">General Information</h3>
        <p class="khas-contact-new-card-text">Learn more about Khas Foods and our products.</p>
      </div>
    </div>
  </div>

  <!-- Interactive Map -->
  <div class="khas-contact-new-section">
    <div class="khas-contact-new-map-wrapper">
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2482.1234567890123!2d-0.1234567890123456!3d51.53012345678901!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x48761b5a5a5a5a5a%3A0x5a5a5a5a5a5a5a5a!2s2%20Frederick%20St%2C%20King%27s%20Cross%2C%20London%20WC1X%200ND%2C%20UK!5e0!3m2!1sen!2suk!4v1234567890123!5m2!1sen!2suk" 
        width="100%" 
        height="400" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        class="khas-contact-new-map">
      </iframe>
    </div>
  </div>

  <!-- Trust Banner -->
  <div class="khas-contact-new-trust">
    <div class="khas-contact-new-trust-decoration left">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#B08D42" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.15">
          <path d="M 10,50 Q 30,30 50,50 Q 30,70 10,50 Z" fill="#B08D42" fill-opacity="0.1" />
        </g>
      </svg>
    </div>
    <div class="khas-contact-new-trust-decoration right">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#B08D42" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.15">
          <path d="M 90,50 Q 70,30 50,50 Q 70,70 90,50 Z" fill="#B08D42" fill-opacity="0.1" />
        </g>
      </svg>
    </div>
    <p class="khas-contact-new-trust-text">Every message matters to us. Our team is committed to providing friendly, timely, and helpful support.</p>
  </div>

  <!-- Call to Action -->
  <div class="khas-contact-new-cta">
    <div class="khas-contact-new-cta-decoration left">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3B2416" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
          <!-- Cardamom pod -->
          <ellipse cx="50" cy="50" rx="15" ry="10" fill="#3B2416" fill-opacity="0.08" />
          <path d="M 50,40 L 50,35" stroke-width="1" />
          <path d="M 45,42 Q 40,38 45,34" stroke-width="0.8" />
          <path d="M 55,42 Q 60,38 55,34" stroke-width="0.8" />
        </g>
      </svg>
    </div>
    <div class="khas-contact-new-cta-decoration right">
      <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3B2416" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
          <!-- Star anise -->
          <g transform="translate(50, 50)">
            <path d="M 0,-15 L 4,-5 L 15,-5 L 6,3 L 9,13 L 0,6 L -9,13 L -6,3 L -15,-5 L -4,-5 Z" fill="#3B2416" fill-opacity="0.08" />
          </g>
        </g>
      </svg>
    </div>
    <div class="khas-contact-new-cta-content">
      <h2 class="khas-contact-new-cta-heading">Let's Stay Connected</h2>
      <p class="khas-contact-new-cta-text">Whether you're looking for authentic ingredients, wholesale opportunities, or product support, we're always happy to hear from you.</p>
      <div class="khas-contact-new-cta-buttons">
        <a href="/collections/all" class="khas-contact-new-btn khas-contact-new-btn--primary">Shop Products</a>
        <a href="/pages/wholesale" class="khas-contact-new-btn khas-contact-new-btn--secondary">Wholesale Enquiries</a>
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Khas Contact New",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Khas Contact New"
    }
  ]
}
{% endschema %}
