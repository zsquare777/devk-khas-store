{{ 'khas-goals-section.css' | asset_url | stylesheet_tag }}

<section class="khas-goals-section" style="background: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="khas-goals-inner">
    <h2 class="khas-goals-heading">
      {{ section.settings.heading_start }}
      {% if section.settings.heading_italic != blank %}
        <em>{{ section.settings.heading_italic }}</em>
      {% endif %}
      {{ section.settings.heading_end }}
    </h2>

    <div class="khas-goals-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="khas-goals-card" style="background-color: {{ block.settings.bg_color }};" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.title }}"
              class="khas-goals-card-img"
              loading="lazy"
            >
          {% endif %}
          <span class="khas-goals-card-title">{{ block.settings.title }}</span>
          <span class="khas-goals-card-arrow">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.75 9H14.25M14.25 9L9.75 4.5M14.25 9L9.75 13.5" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Khas Goals Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading (before italic)",
      "default": "Foodsss to"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic word)",
      "default": "fuel"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading (after italic)",
      "default": "your goals."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "goal_card",
      "name": "Goal Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card title",
          "default": "More protein"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#3d3a8c"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Khas Goals Section",
      "blocks": [
        {
          "type": "goal_card",
          "settings": {
            "title": "More protein",
            "bg_color": "#3d3a8c"
          }
        },
        {
          "type": "goal_card",
          "settings": {
            "title": "Eat healthy",
            "bg_color": "#d4a017"
          }
        },
        {
          "type": "goal_card",
          "settings": {
            "title": "Manage weight",
            "bg_color": "#7a9e7e"
          }
        },
        {
          "type": "goal_card",
          "settings": {
            "title": "Save time",
            "bg_color": "#b5843a"
          }
        }
      ]
    }
  ]
}
{% endschema %}
