{%- if page.handle == 'shipping-returns' -%}
  {{ 'khas-shipping-returns.css' | asset_url | stylesheet_tag }}
  <section class="khas-shipping-returns" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {% render 'khas-shipping-returns-content' %}
  </section>
{%- elsif page.handle == 'terms-conditions' -%}
  {{ 'khas-terms.css' | asset_url | stylesheet_tag }}
  <section class="khas-terms" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {% render 'khas-terms-content' %}
  </section>
{%- elsif page.handle == 'faq' -%}
  {{ 'khas-faq.css' | asset_url | stylesheet_tag }}
  {{ 'khas-faq.js' | asset_url | script_tag }}
  <section class="khas-faq" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {% render 'khas-faq-content' %}
  </section>
{%- elsif page.handle == 'about-us' -%}
  {{ 'khas-about.css' | asset_url | stylesheet_tag }}
  <section class="khas-about-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    {% render 'khas-about-content' %}
  </section>
{%- else -%}
  <div class="page-width page-width--narrow" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <h1 class="main-page-title page-header h1">
      {{ page.title | escape }}
    </h1>
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ]
}
{% endschema %}
