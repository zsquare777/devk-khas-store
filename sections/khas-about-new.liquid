          <ellipse cx="100" cy="70" rx="4" ry="8" fill="#3B2416" fill-opacity="0.08" transform="rotate(-30 100 70)" />
          <ellipse cx="100" cy="70" rx="4" ry="8" fill="#3B2416" fill-opacity="0.08" transform="rotate(30 100 70)" />
          <ellipse cx="100" cy="90" rx="4" ry="8" fill="#3B2416" fill-opacity="0.08" transform="rotate(-30 100 90)" />
          <ellipse cx="100" cy="90" rx="4" ry="8" fill="#3B2416" fill-opacity="0.08" transform="rotate(30 100 90)" />
