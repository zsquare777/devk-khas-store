          <ellipse cx="100" cy="130" rx="4" ry="8" fill="#3B2416" fill-opacity="0.08" transform="rotate(-30 100 130)" />
          <ellipse cx="100" cy="130" rx="4" ry="8" fill="#3B2416" fill-opacity="0.08" transform="rotate(30 100 130)" />
