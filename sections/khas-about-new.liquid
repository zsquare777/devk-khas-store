          <path d="M 100,100 Q 115,95 130,100 Q 115,105 100,100 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 100,140 Q 85,135 70,140 Q 85,145 100,140 Z" fill="#3B2416" fill-opacity="0.06" />
