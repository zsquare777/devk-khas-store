{{ 'khas-about-new.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .khas-about-new-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="khas-about-new khas-about-new-{{ section.id }}" id="KhasAboutNewSection">
  
