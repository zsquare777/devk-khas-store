            <path d="M 16,34 L 32,34" stroke="#B08D42" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="khas-wholesale-card-heading">Competitive Pricing</h3>
        <p class="khas-wholesale-card-text">Designed for businesses of every size with flexible terms.</p>
      </div>
      <div class="khas-wholesale-card">
        <div class="khas-wholesale-card-icon">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="4" y="20" width="40" height="20" rx="3" stroke="#B08D42" stroke-width="2" fill="none"/>
            <circle cx="12" cy="40" r="4" stroke="#B08D42" stroke-width="2" fill="none"/>
