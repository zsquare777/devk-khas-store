{{ 'khas-wholesale.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .khas-wholesale-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="khas-wholesale khas-wholesale-{{ section.id }}" id="KhasWholesaleSection">
  
  <!-- Hero Section -->
  <div class="khas-wholesale-hero">
    <!-- Top Left Botanical Decoration - Pepper Vine -->
    <div class="khas-wholesale-decoration top-left">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3B2416" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
          <!-- Pepper vine -->
          <path d="M 10,180 C 30,170 50,170 70,160 C 90,150 110,150 130,140 C 150,130 170,120 180,100" />
          <!-- Pepper berries -->
          <circle cx="30" cy="172" r="6" fill="#3B2416" fill-opacity="0.08" />
          <circle cx="55" cy="162" r="6" fill="#3B2416" fill-opacity="0.08" />
          <circle cx="80" cy="152" r="6" fill="#3B2416" fill-opacity="0.08" />
          <circle cx="105" cy="142" r="6" fill="#3B2416" fill-opacity="0.08" />
          <circle cx="130" cy="132" r="6" fill="#3B2416" fill-opacity="0.08" />
          <circle cx="155" cy="122" r="6" fill="#3B2416" fill-opacity="0.08" />
          <!-- Small leaves -->
          <path d="M 25,165 Q 20,158 25,151 Q 30,158 25,165 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 50,155 Q 45,148 50,141 Q 55,148 50,155 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 75,145 Q 70,138 75,131 Q 80,138 75,145 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 100,135 Q 95,128 100,121 Q 105,128 100,135 Z" fill="#3B2416" fill-opacity="0.06" />
          <path d="M 125,125 Q 120,118 125,111 Q 130,118 125,125 Z" fill="#3B2416" fill-opacity="0.06" />
        </g>
      </svg>
    </div>

    <!-- Bottom Right Botanical Decoration - Spice Blossom -->
    <div class="khas-wholesale-decoration bottom-right">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g stroke="#3B2416" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
          <!-- Spice blossom center -->
          <circle cx="100" cy="100" r="15" fill="#3B2416" fill-opacity="0.08" />
          <!-- Petals -->
          <ellipse cx="100" cy="60" rx="8" ry="20" fill="#3B2416" fill-opacity="0.06" />
          <ellipse cx="140" cy="100" rx="20" ry="8" fill="#3B2416" fill-opacity="0.06" />
          <ellipse cx="100" cy="140" rx="8" ry="20" fill="#3B2416" fill-opacity="0.06" />
          <ellipse cx="60" cy="100" rx="20" ry="8" fill="#3B2416" fill-opacity="0.06" />
          <!-- Diagonal petals -->
          <ellipse cx="128" cy="72" rx="8" ry="18" fill="#3B2416" fill-opacity="0.05" transform="rotate(45 128 72)" />
          <ellipse cx="128" cy="128" rx="8" ry="18" fill="#3B2416" fill-opacity="0.05" transform="rotate(-45 128 128)" />
          <ellipse cx="72" cy="128" rx="8" ry="18" fill="#3B2416" fill-opacity="0.05" transform="rotate(45 72 128)" />
          <ellipse cx="72" cy="72" rx="8" ry="18" fill="#3B2416" fill-opacity="0.05" transform="rotate(-45 72 72)" />
          <!-- Small decorative dots -->
          <circle cx="100" cy="100" r="3" fill="#3B2416" fill-opacity="0.1" />
        </g>
      </svg>
    </div>

    <div class="khas-wholesale-hero-content">
      <div class="khas-wholesale-crown">
        <svg viewBox="0 0 100 35" width="120" height="42" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 40,30 L 60,30 L 62,24 L 56,26 L 50,15 L 44,26 L 38,24 Z" fill="#fabd2f" />
          <circle cx="50" cy="13" r="1.5" fill="#fabd2f" />
          <circle cx="38" cy="22" r="1" fill="#fabd2f" />
          <circle cx="62" cy="22" r="1" fill="#fabd2f" />
          <path d="M 42,28 Q 50,29 58,28" stroke="#fabd2f" stroke-width="1" />
        </svg>
      </div>
      <h1 class="khas-wholesale-hero-heading">Wholesale Partnerships</h1>
      <p class="khas-wholesale-hero-subheading">Bring the authentic taste of Khas Foods to your customers with premium-quality spices, herbs, pastes, salts, and everyday essentials.</p>
      <div class="khas-wholesale-hero-buttons">
        <a href="#wholesale-form" class="khas-wholesale-btn khas-wholesale-btn--primary">Become a Wholesale Partner</a>
        <a href="/collections/all" class="khas-wholesale-btn khas-wholesale-btn--secondary">Browse Products</a>
      </div>
    </div>
  </div>

  <!-- Why Partner With Khas -->
