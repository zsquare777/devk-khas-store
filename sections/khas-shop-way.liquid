{{ 'khas-shop-way.css' | asset_url | stylesheet_tag }}

<section class="khas-shop-way" style="background: {{ section.settings.background_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="khas-shop-way-inner">
    <h2 class="khas-shop-way-heading">
      {{ section.settings.heading_start }}
      {% if section.settings.heading_italic != blank %}
        <em>{{ section.settings.heading_italic }}</em>
      {% endif %}
      {{ section.settings.heading_end }}
    </h2>

    <div class="khas-shop-way-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="khas-shop-way-card" {{ block.shopify_attributes }}>
          <span class="khas-shop-way-card-img-wrap">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 160 }}"
                alt="{{ block.settings.title }}"
                class="khas-shop-way-card-img"
                loading="lazy"
              >
            {% endif %}
          </span>
          <span class="khas-shop-way-card-title">{{ block.settings.title }}</span>
          <span class="khas-shop-way-card-arrow">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.75 9H14.25M14.25 9L9.75 4.5M14.25 9L9.75 13.5" stroke="#111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Khas Shop Way",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading (before italic)",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic word)",
      "default": "your"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading (after italic)",
      "default": "way"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Powdered Meals"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Khas Shop Way",
      "blocks": [
        { "type": "category_card", "settings": { "title": "Powdered Meals" } },
        { "type": "category_card", "settings": { "title": "Bundles" } },
        { "type": "category_card", "settings": { "title": "Ready-to-drink Meals" } },
        { "type": "category_card", "settings": { "title": "Hot Instant Meals" } },
        { "type": "category_card", "settings": { "title": "Greens & Superfoods" } },
        { "type": "category_card", "settings": { "title": "Drinks & Snacks" } }
      ]
    }
  ]
}
{% endschema %}
