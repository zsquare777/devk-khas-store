{{ 'khas-hero-banner.css' | asset_url | stylesheet_tag }}
<!-- Cache bust: {{ 'now' | date: '%s' }} -->

{%- style -%}
  .khas-hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="khas-hero khas-hero-{{ section.id }}">
  
  <!-- Left Botanical Overlay -->
  <svg class="khas-hero-overlay left" viewBox="0 0 200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g stroke="#c9a3272a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
      <path d="M -20,50 C 50,80 80,150 40,220 C 10,270 -30,250 -40,180 C -50,110 10,80 30,120" />
      <path d="M 40,220 C 80,260 120,380 60,450 C 20,490 -40,460 -30,380 C -20,300 40,320 50,370" />
      <path d="M 18,90 Q 50,60 70,80 Q 40,110 18,90 Z" fill="#c9a3272a" fill-opacity="0.2" />
      <path d="M 32,170 Q 75,150 90,180 Q 55,210 32,170 Z" fill="#c9a3272a" fill-opacity="0.2" />
      <path d="M 45,290 Q 95,270 110,310 Q 70,335 45,290 Z" fill="#c9a3272a" fill-opacity="0.2" />
      <path d="M -10,130 Q 20,150 0,180" />
      <path d="M 5,320 Q 40,340 15,380" />
    </g>
  </svg>

  <!-- Right Botanical Overlay -->
  <svg class="khas-hero-overlay right" viewBox="0 0 200 600" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g stroke="#c9a227" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.1">
      <path d="M -20,50 C 50,80 80,150 40,220 C 10,270 -30,250 -40,180 C -50,110 10,80 30,120" />
      <path d="M 40,220 C 80,260 120,380 60,450 C 20,490 -40,460 -30,380 C -20,300 40,320 50,370" />
      <path d="M 18,90 Q 50,60 70,80 Q 40,110 18,90 Z" fill="#c9a227" fill-opacity="0.2" />
      <path d="M 32,170 Q 75,150 90,180 Q 55,210 32,170 Z" fill="#c9a227" fill-opacity="0.2" />
      <path d="M 45,290 Q 95,270 110,310 Q 70,335 45,290 Z" fill="#c9a227" fill-opacity="0.2" />
      <path d="M -10,130 Q 20,150 0,180" />
      <path d="M 5,320 Q 40,340 15,380" />
    </g>
  </svg>

  <div class="khas-hero__inner page-width">

    <div class="khas-hero__content">

      <div class="khas-hero__crown">
        <svg viewBox="0 0 100 35" width="120" height="42" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M 40,30 L 60,30 L 62,24 L 56,26 L 50,15 L 44,26 L 38,24 Z" fill="#7e0d0d" />
          <circle cx="50" cy="13" r="1.5" fill="#7e0d0d" />
          <circle cx="38" cy="22" r="1" fill="#7e0d0d" />
          <circle cx="62" cy="22" r="1" fill="#7e0d0d" />
          <path d="M 42,28 Q 50,29 58,28" stroke="#7e0d0d" stroke-width="1" />
        </svg>
      </div>

      {%- if section.settings.show_rating -%}
        <div class="khas-hero__rating">
          <div class="khas-hero__stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.44.91-5.32L2.27 6.62l5.34-.78z"/>
              </svg>
            {%- endfor -%}
          </div>
          <span class="khas-hero__rating-text">
            {{- section.settings.rating_text | escape -}}
          </span>
        </div>
      {%- endif -%}

      <h2 class="khas-hero__heading">
        {{- section.settings.heading_start | escape -}}
        {%- if section.settings.heading_italic != blank -%}
          <em>{{- section.settings.heading_italic | escape -}}</em>
        {%- endif -%}
        {{- section.settings.heading_end | escape -}}
      </h2>

      {%- if section.settings.subheading != blank -%}
        <p class="khas-hero__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="khas-hero__buttons">
        {%- if section.settings.button1_text != blank -%}
          <a href="{{ section.settings.button1_link | default: '#' }}" class="khas-hero__btn khas-hero__btn--primary">
            {{- section.settings.button1_text | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_text != blank -%}
          <a href="{{ section.settings.button2_link | default: '#' }}" class="khas-hero__btn khas-hero__btn--secondary">
            {{- section.settings.button2_text | escape -}}
          </a>
        {%- endif -%}
      </div>

    </div>

    {%- if section.settings.image != blank -%}
      <div class="khas-hero__image-wrapper">
        <div class="khas-hero__image-container">
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              class: 'khas-hero__image',
              loading: 'lazy',
              widths: '450, 600, 750, 900',
              sizes: '(max-width: 989px) 100vw, 50vw',
              alt: section.settings.image.alt | default: shop.name
          }}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Khas Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4M+ happy customers"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading (bold part)",
      "default": "Bring Authentic "
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic word",
      "default": "Flavour",
      "info": "This word renders in italic serif style"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading end (bold part)",
      "default": " to Every Kitchen"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium spices, herbs, pastes, salts, and everyday essentials crafted to bring rich taste and trusted quality to every meal."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button1_text",
      "label": "Primary button text",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Secondary button text",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Khas Hero Banner"
    }
  ]
}
{% endschema %}
